    config = DatabaseConfig()  # Reads from .env file
    
# ✅ GOOD: Controla todas las dependencias
def test_config(monkeypatch):
    monkeypatch.setenv("MYSQL_USER", "test_user")
    config = DatabaseConfig(cargar_dotenv=False)
```

