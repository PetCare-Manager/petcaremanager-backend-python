def test_config_engine_desarrollo_mysql_default(monkeypatch):
    """
    Este test verifica que la configuración de base de datos funcione bien.
    
    Es como probar que una receta de cocina salga igual cada vez:
    - Le damos los ingredientes exactos (variables de entorno)
    - Seguimos la receta (crear DatabaseConfig)
    - Probamos que el resultado sea correcto (verificar configuración)
    """
    
    # ============ 1. PREPARAR: Como limpiar la cocina antes de cocinar ============
    
    # Borrar configuraciones viejas que podrían estorbar
    monkeypatch.delenv("USE_MYSQL", raising=False)      # Borra "USE_MYSQL" si existe
    monkeypatch.delenv("DATABASE_URL", raising=False)   # Borra "DATABASE_URL" si existe
    # Es como tirar ingredientes viejos antes de cocinar algo nuevo
    
    # Decirle al sistema "estamos en modo desarrollo" (no producción)
    monkeypatch.setenv("Entorno", "desarrollo")
    # Como decir "vamos a cocinar en casa, no en un restaurante elegante"
    
    # Darle las "llaves" para conectarse a la base de datos
    monkeypatch.setenv("MYSQL_USER", "test_user")       # Usuario = como el nombre de usuario
    monkeypatch.setenv("MYSQL_PASSWORD", "test_password") # Contraseña = como la clave de acceso
    monkeypatch.setenv("MYSQL_DATABASE", "test_database") # Base de datos = como el nombre del archivo
    # Es como darle las llaves de la casa donde están guardados los datos
    
    # Configurar números específicos para probar que REALMENTE lee lo que le decimos
    monkeypatch.setenv("MYSQL_POOL_SIZE", "15")         # "Usa 15 cocineros"
    monkeypatch.setenv("MYSQL_MAX_OVERFLOW", "25")      # "Si necesitas más, puedes llamar hasta 25"
    # Usamos números raros (15, 25) en lugar de normales (10, 20) para estar seguros
    # que está leyendo NUESTROS números, no usando números por defecto
    
    # ============ 2. COCINAR: Crear la configuración ============
    
    # Crear el objeto que maneja la configuración
    config = DatabaseConfig()
    # Como llamar al chef y decirle "prepárate para cocinar"
    
    # Pedirle que nos diga exactamente cómo va a configurar la conexión
    engine_config = config.obtener_config_engine()
    # Como preguntarle al chef "¿qué utensilios vas a usar exactamente?"
    
    # ============ 3. PROBAR: Verificar que todo salió bien ============
    
    # A) Verificar que nos dio una lista organizada (no basura)
    assert isinstance(engine_config, dict), (
        f"ERROR: Esperaba una lista organizada, pero me dio: {type(engine_config)}"
    )
    # Como verificar que el chef te dio una lista de utensilios, no un dibujo
    
    # B) Verificar que la lista no esté vacía
    assert len(engine_config) > 1, (
        f"ERROR: La lista está muy vacía: {engine_config}"
    )
    # Como verificar que la lista del chef tiene más de una cosa
    
    # C) Verificar que en modo desarrollo nos muestre los detalles (echo=True)
    assert engine_config.get("echo") is True, (
        f"ERROR: En desarrollo debería mostrar detalles (echo=True), "
        f"pero está en: {engine_config.get('echo')}"
    )
    # En casa (desarrollo) quieres que el chef te diga cada paso
    # En restaurante (producción) no necesitas tanto detalle
    
    # D) Verificar que tenga TODAS las configuraciones importantes de MySQL
    configuraciones_importantes = {
        "pool_size": int,       # ¿Cuántos cocineros normalmente?
        "max_overflow": int,    # ¿Cuántos cocineros extra si hay mucho trabajo?
        "pool_timeout": int,    # ¿Cuánto tiempo esperar por un cocinero libre?
        "pool_recycle": int,    # ¿Cada cuánto los cocineros toman descanso?
        "pool_pre_ping": bool   # ¿Verificar que los cocineros estén despiertos?
    }
    
    for cosa, tipo_esperado in configuraciones_importantes.items():
        # Verificar que cada cosa importante esté en la lista
        assert cosa in engine_config, (
            f"ERROR: Falta '{cosa}' en la configuración: {engine_config}"
        )
        
        # Verificar que cada cosa sea del tipo correcto (número, texto, etc.)
        assert isinstance(engine_config[cosa], tipo_esperado), (
            f"ERROR: '{cosa}' debería ser {tipo_esperado.__name__}, "
            f"pero es {type(engine_config[cosa])}"
        )
    
    # E) Verificar que use NUESTROS números, no los números por defecto
    assert engine_config["pool_size"] == 15, (
        f"ERROR: Le dijimos que use 15 cocineros, pero usa: {engine_config['pool_size']}"
    )
    # Si le dijimos "usa 15" y realmente usa 15, sabemos que nos está escuchando
    
    assert engine_config["max_overflow"] == 25, (
        f"ERROR: Le dijimos máximo 25 extra, pero usa: {engine_config['max_overflow']}"
    )
    # Si le dijimos "máximo 25 extra" y realmente usa 25, sabemos que lee nuestra config
    
    # F) Verificar valores que NO configuramos (deberían usar valores normales)
    assert engine_config["pool_timeout"] == 30, (
        f"ERROR: Sin configuración especial, debería usar 30, pero usa: {engine_config['pool_timeout']}"
    )
    
    assert engine_config["pool_recycle"] == 3600, (
        f"ERROR: Sin configuración especial, debería usar 3600, pero usa: {engine_config['pool_recycle']}"
    )
    
    assert engine_config["pool_pre_ping"] is True, (
        f"ERROR: Debería verificar conexiones (True), pero está: {engine_config['pool_pre_ping']}"
    )
    
    # G) Verificar que NO tenga cosas que no deberían estar ahí
    cosas_que_no_van = ["database_url", "charset", "host", "port"]
    for cosa_mala in cosas_que_no_van:
        assert cosa_mala not in engine_config, (
            f"ERROR: '{cosa_mala}' no debería estar aquí: {engine_config}"
        )
    # Como verificar que el chef no puso sal en el postre
    
    # H) Probar que la configuración REALMENTE funcione con el programa real
    try:
        from sqlalchemy import create_engine
        # Crear una base de datos de prueba en memoria (no afecta nada)
        test_url = "sqlite:///:memory:"
        # Probar si SQLAlchemy acepta nuestra configuración
        test_engine = create_engine(test_url, **engine_config)
        assert test_engine is not None, "La configuración debería funcionar"
    except Exception as e:
        assert False, f"ERROR: La configuración no funciona con SQLAlchemy: {e}"
    # Como pedirle a un chef real que pruebe si los utensilios funcionan
    
    # ============ 4. MOSTRAR RESULTADOS (para que aprendas) ============
    
    print(f"\n🎉 ¡TEST EXITOSO! La configuración funciona perfectamente")
    print(f"📋 Configuración completa: {engine_config}")
    print(f"📊 Total de configuraciones: {len(engine_config)}")
    print(f"👁️ Mostrar detalles (echo): {engine_config['echo']}")
    print(f"👥 Número de cocineros (pool_size): {engine_config['pool_size']}")
    print(f"➕ Cocineros extra máximo: {engine_config['max_overflow']}")
    
    # Esta información solo la ves si ejecutas el test con: pytest -s
    # Te ayuda a entender qué está pasando y cómo se ve una configuración correcta